{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/**", "function": "api", "region": "asia-southeast1" }
    ]
  },
  "functions": [
    {
      "source": ".",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "dist",
        "src/frontend",
        "vite.config.js",
        "firebase/setup.md",
        "firebase/*.json",
        "*.md"
      ]
    }
  ]
}
